# These are environment variable examples. The launcher does not auto-load .env.
# Set them in your shell, or pass launcher flags documented in README.md.
TZ_DATA_BACKEND=auto
TZ_MYSQL_HOST=127.0.0.1
TZ_MYSQL_PORT=3306
TZ_MYSQL_USER=root
# Do not commit actual passwords. start_mysql_api.cmd prompts locally.
TZ_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
